{
  "name": "college-erp",
  "version": "1.0.0",
  "description": "College ERP — SOC CoPilot Test Client",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "install:all": "cd client && npm install && cd ../server && npm install",
    "migrate:up": "cd server && npm run migrate:up",
    "migrate:down": "cd server && npm run migrate:down",
    "db:seed": "cd server && npm run db:seed",
    "test:academic": "cd server && npm run test:academic"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
